# ── Dependencies ─────────────────────────────────────────────
/node_modules
/.pnp
.pnp.*
.yarn/*

# ── Next.js build output ─────────────────────────────────────
/.next/
/out/
/build
next-env.d.ts
*.tsbuildinfo

# ── Production / deploy ──────────────────────────────────────
/dist
.vercel

# ── Environment & secrets (NEVER commit) ─────────────────────
.env
.env.*
!.env.example
# Legacy provider config (obsolete after the provider-agnostic AI migration)
.z-ai-config

# ── Database (local SQLite) ──────────────────────────────────
/db/*.db
/db/*.db-journal
/prisma/*.db
/prisma/*.db-journal
/prisma/db/*.db
/prisma/db/*.db-journal
/prisma/migrations/dev.db*

# ── Logs ─────────────────────────────────────────────────────
*.log
dev.log
server.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Package manager lockfiles from other tools ───────────────
bun.lock
bun.lockb
yarn.lock
pnpm-lock.yaml

# ── Editor / OS ──────────────────────────────────────────────
.DS_Store
*.pem
.idea/
.vscode/*
!.vscode/extensions.json

# ── Test / coverage ──────────────────────────────────────────
/coverage
.turbo

# ── Local-only working material (kept on disk, not published) ─
/.claude/
/docs/
/Obsi/
/handover/presentation-pack/
