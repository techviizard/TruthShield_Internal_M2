# ─────────────────────────────────────────────────────────────
# TruthShield environment configuration
#
# Every setting below is consumed by ONE file: `src/config/app.config.ts`.
# Nothing else in the app reads process.env - configure here, no code changes.
#
# Copy this file to `.env.local` (or `.env`) and fill in real values.
# NEVER commit the filled-in file - only this .example is committed.
# ─────────────────────────────────────────────────────────────

# ── App identity ─────────────────────────────────────────────
APP_NAME=TruthShield
APP_VERSION=3.3.0
# Absolute base URL of this deployment (used for absolute links in exports).
APP_URL=http://localhost:3000
PORT=3000
# debug | info | warn | error
LOG_LEVEL=info
APP_DEFAULT_LANGUAGE=en
APP_SUPPORTED_LANGUAGES=en,hi,ta,te,bn,mr,gu,kn,ml,pa

# ── Database ─────────────────────────────────────────────────
# SQLite (default, zero-infra). For production use Postgres:
#   DATABASE_URL="postgresql://user:pass@host:5432/truthshield"
DATABASE_URL="file:./db/custom.db"
# Log every Prisma query (very noisy - dev debugging only).
DATABASE_LOG_QUERIES=false

# ─────────────────────────────────────────────────────────────
# AI PROVIDER  (provider-agnostic - switch with env only, no code changes)
# ─────────────────────────────────────────────────────────────
# Which provider preset to use. One of:
#   openai | anthropic | kimi | qwen | ollama | lmstudio | custom
AI_PROVIDER=openai

# API key for the selected provider.
# Local providers (ollama/lmstudio) don't need a real key - any value works.
AI_API_KEY=sk-your-key-here

# Optional: override the endpoint. Each preset has a sensible default;
# set this for `custom`, self-hosted, or proxy endpoints.
#   openai   -> https://api.openai.com/v1        (default)
#   kimi     -> https://api.moonshot.cn/v1        (default)
#   qwen     -> https://dashscope.aliyuncs.com/compatible-mode/v1 (default)
#   ollama   -> http://localhost:11434/v1         (default)
#   lmstudio -> http://localhost:1234/v1          (default)
# AI_BASE_URL=

# Optional: model overrides (each preset has a default).
# AI_MODEL=gpt-4o-mini
# AI_VISION_MODEL=gpt-4o-mini

# Optional: generation tuning + request timeout (ms).
# AI_TEMPERATURE=0.2
# AI_MAX_TOKENS=2048
# AI_TIMEOUT_MS=120000

# Set to "false" for text-only local models that can't do image analysis
# (image/video forensics tabs will then return a clear "not supported" message).
# AI_VISION_ENABLED=true

# ── Example: run fully local with Ollama ─────────────────────
# AI_PROVIDER=ollama
# AI_MODEL=llama3.1
# AI_VISION_MODEL=llava
# (no AI_API_KEY needed)

# ── Example: Anthropic Claude ────────────────────────────────
# AI_PROVIDER=anthropic
# AI_API_KEY=sk-ant-...
# AI_MODEL=claude-sonnet-4-5

# ─────────────────────────────────────────────────────────────
# WEB SEARCH  (optional - powers live sources for Fact Check + Reverse Image)
# Generic LLM providers don't include web search, so it's a separate provider.
# Leave as "none" to run without live sources (fact-check still works on model
# reasoning alone).
# ─────────────────────────────────────────────────────────────
# One of: none | tavily | brave
SEARCH_PROVIDER=none
# SEARCH_API_KEY=your-search-api-key
SEARCH_MAX_RESULTS=10

# ─────────────────────────────────────────────────────────────
# DEMO / TEST ACCOUNT
# Used by `npm run db:seed` to create the demo analyst account and (optionally)
# a realistic set of demo analyses so every dashboard widget has real rows.
# Defaults to enabled outside production.
# ─────────────────────────────────────────────────────────────
DEMO_MODE=true
DEMO_USER_EMAIL=analyst@truthshield.local
DEMO_USER_PASSWORD=TruthShield#Demo2025
DEMO_USER_NAME=Demo Analyst
DEMO_USER_ROLE=analyst
# Seed sample analyses/alerts/investigations alongside the demo user.
DEMO_SEED_SAMPLE_DATA=true
DEMO_SAMPLE_REPORT_COUNT=60

# ── Feature flags ────────────────────────────────────────────
FEATURE_COMMUNITY_REPORTS=true
FEATURE_WATCHLIST_SCANNING=true
FEATURE_AUDIT_LOG=true
FEATURE_WORKFLOW_AUTOMATION=true

# ── Limits ───────────────────────────────────────────────────
MAX_IMAGE_UPLOAD_MB=20
MAX_VIDEO_UPLOAD_MB=100
MAX_AUDIO_UPLOAD_MB=50
MAX_TEXT_CHARS=50000
HISTORY_PAGE_SIZE=10
ALERTS_PAGE_SIZE=20
INVESTIGATIONS_PAGE_SIZE=20
AUDIT_LOG_PAGE_SIZE=50
LIVE_FEED_LIMIT=20
NETWORK_GRAPH_NODE_LIMIT=200

# ── Dashboard behaviour ──────────────────────────────────────
# Client poll interval for dashboard widgets (ms). 0 disables polling.
DASHBOARD_REFRESH_MS=60000
LIVE_FEED_REFRESH_MS=15000
DASHBOARD_TICKER_LIMIT=8
DASHBOARD_ACTIVITY_LIMIT=10
DASHBOARD_TOP_THREATS_LIMIT=5
DASHBOARD_SPARKLINE_DAYS=7
DASHBOARD_TREND_DAYS=7
# 24h | 7d | 30d
DASHBOARD_THREAT_RANGE=30d

# ── Analysis tuning ──────────────────────────────────────────
# Campaign clustering (TF-IDF cosine similarity threshold + min cluster size).
CAMPAIGN_SIMILARITY=0.32
CAMPAIGN_MIN_CLUSTER_SIZE=3
CAMPAIGN_LOOKBACK_DAYS=30
# Trust score at/below which a report counts as a threat.
THREAT_TRUST_THRESHOLD=50
